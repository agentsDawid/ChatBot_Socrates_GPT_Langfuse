# Required for OpenAI API access. The app can ask for this key if left blank.
OPENAI_API_KEY=""

# Optional: set BOTH keys to enable Langfuse tracing.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# Langfuse Cloud endpoint for your project's region.
# EU default: https://cloud.langfuse.com
# US:         https://us.cloud.langfuse.com
LANGFUSE_HOST="https://cloud.langfuse.com"

# Alternatively, app.py also accepts LANGFUSE_BASE_URL instead of LANGFUSE_HOST.
# Use only one of these variables to avoid ambiguity.
# LANGFUSE_BASE_URL="https://cloud.langfuse.com"
